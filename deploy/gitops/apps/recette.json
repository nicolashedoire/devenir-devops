{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Application",
  "metadata": {
    "name": "taskboard-recette",
    "namespace": "argocd"
  },
  "spec": {
    "project": "taskboard",
    "source": {
      "repoURL": "https://github.com/nicolashedoire/devenir-devops.git",
      "targetRevision": "main",
      "path": "deploy/helm/taskboard",
      "helm": {
        "releaseName": "taskboard",
        "valueFiles": [
          "../../gitops/environments/recette/values.yaml"
        ]
      }
    },
    "destination": {
      "server": "https://kubernetes.default.svc",
      "namespace": "taskboard-recette"
    },
    "syncPolicy": {
      "automated": {
        "prune": true,
        "selfHeal": true,
        "allowEmpty": false
      },
      "syncOptions": [
        "PruneLast=true"
      ],
      "retry": {
        "limit": 3,
        "backoff": {
          "duration": "10s",
          "factor": 2,
          "maxDuration": "60s"
        }
      }
    }
  }
}
