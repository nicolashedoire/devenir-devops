# Exemple sans credentials. Le bootstrap peut produire ces champs via sa sortie backend_hcl.
bucket              = "taskboard-etat-remplacer-par-un-nom-unique"
key                 = "taskboard/lab/foundations.tfstate"
region              = "eu-west-3"
allowed_account_ids = ["123456789012"]
encrypt             = true
use_lockfile        = true
